# Copie para .env e troque os valores. O .env nunca vai para o Git.
REVENDA_DB_PASSWORD=troque-esta-senha
# Segredo enviado pelo gateway de pagamento no header X-Webhook-Secret
WEBHOOK_SECRET=troque-este-segredo
GRAFANA_ADMIN_PASSWORD=troque-esta-senha-do-grafana
# Porta pública do API Gateway (no servidor usamos 80)
GATEWAY_PORT=8080
GRAFANA_PORT=3000
